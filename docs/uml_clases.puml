@startuml AvilaOS_DiagramaClases

skinparam classAttributeIconSize 0
skinparam linetype ortho

interface Clockable {
  +tic(cicloActual: long)
}

class RelojGlobal {
  -cicloActual: long
  -velocidadMs: long
  +iniciar()
  +pausar()
  +paso()
  +suscribir(c: Clockable)
  +setCerrojo(cerrojo: Semaphore)
}

class Cluster {
  -latenciaRed: int
  -cerrojo: Semaphore
  +crearBuffer(nombre, capacidad, host): BufferSO
  +asignarProcesoManual(p, computadorId)
  +asignarProcesoAutomatico(p): Computador
  +crearReloj(ms): RelojGlobal
  +registrarEvento(mensaje)
}

interface CriterioAsignacion {
  +elegir(computadores, proceso): Computador
}

class MenorCarga

class Computador {
  -id: int
  -nombre: String
  -quantum: int
  +tic(ciclo: long)
  +recibirProceso(p)
  +intentarAdmitirNuevos(): int
  +terminarProceso(p)
  +bloquearPorSemaforo(p, motivo)
  +bloquearPorTiempo(p, ciclos, motivo)
  +liberarSemaforo(s)
  +procesarDespertares()
  +setPolitica(estrategia, nombre)
}

class CPU {
  -pc: int
  -mar: int
  -modo: ModoCPU
  +cargarProceso(p)
  +registrarPc(direccion)
}

class RAM {
  -capacidadTotal: int
  -memoriaUsada: int
  +asignarMemoria(p): boolean
  +liberarMemoria(p)
  +reservar(n): boolean
}

class Proceso {
  -id: int
  -nombre: String
  -computadorId: int
  -estado: EstadoProceso
  -tipo: TipoProceso
  -prioridad: int
  -memoriaRequerida: int
  -deadline: int
  -tiempoRestante: int
  -pc: int
  -motivoBloqueo: String
  +ejecutarUnCiclo()
  +descontarDeadline(): boolean
  +cumplioDeadline(): boolean
}

interface PoliticaPlanificacionStrategy {
  +seleccionar(listos): Proceso
  +alLlegar(proceso, listos)
}
class FCFS
class EDF
class RoundRobin
class PrioridadesApropiativas

interface ProgramaProceso {
  +ejecutar(computador, proceso): ResultadoCiclo
  +alTerminar(computador, proceso)
}
class ProgramaCpuBound
class ProgramaIoBound
class ProgramaProductorConsumidor

class SemaforoSO {
  -nombre: String
  -tipo: TipoSemaforo
  -valor: int
  +semWait(p): boolean
  +semSignal(): Proceso
  +cancelarEspera(p): boolean
}

class BufferSO {
  -nombre: String
  -capacidad: int
  -elementos: int
  +insertar()
  +extraer()
}

enum EstadoProceso {
  NUEVO
  LISTO
  EJECUCION
  BLOQUEADO
  TERMINADO
}
enum TipoProceso {
  CPU_BOUND
  IO_BOUND
  PRODUCTOR
  CONSUMIDOR
}
enum ModoCPU {
  USUARIO
  SISTEMA_OPERATIVO
}
enum PoliticaPlanificacion {
  FCFS
  EDF
  ROUND_ROBIN
  PRIORIDADES
}
enum ResultadoCiclo {
  CONTINUA
  BLOQUEADO
  TERMINADO
}

RelojGlobal o--> "*" Clockable : suscriptores
Computador ..|> Clockable
Cluster *--> "2..8" Computador
Cluster ..> RelojGlobal : crearReloj
Cluster --> CriterioAsignacion : criterio
MenorCarga ..|> CriterioAsignacion
Cluster *--> "*" BufferSO : buffers
Computador *--> "1" CPU
Computador *--> "1" RAM
Computador --> PoliticaPlanificacionStrategy : politica
FCFS ..|> PoliticaPlanificacionStrategy
EDF ..|> PoliticaPlanificacionStrategy
RoundRobin ..|> PoliticaPlanificacionStrategy
PrioridadesApropiativas ..|> PoliticaPlanificacionStrategy
Computador o--> "*" Proceso : colas
Proceso --> ProgramaProceso : programa
ProgramaCpuBound ..|> ProgramaProceso
ProgramaIoBound ..|> ProgramaProceso
ProgramaProductorConsumidor ..|> ProgramaProceso
ProgramaProductorConsumidor --> BufferSO : usa
BufferSO *--> "3" SemaforoSO : vacios, llenos, mutex
SemaforoSO ..> Proceso : cola de espera
Proceso --> EstadoProceso
Proceso --> TipoProceso
CPU --> ModoCPU
Computador --> PoliticaPlanificacion

@enduml
