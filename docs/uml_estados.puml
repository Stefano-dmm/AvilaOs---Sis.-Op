@startuml AvilaOS_EstadosProceso

[*] --> Nuevo : crear proceso

Nuevo --> Listo : hay RAM suficiente\n(admision)
Listo --> Ejecucion : lo despacha el planificador
Ejecucion --> Listo : quantum vencido o\ndesalojo por prioridad
Ejecucion --> Terminado : completa sus instrucciones

state Bloqueado {
  state "Esperando semaforo" as BloqSem
  state "Esperando E/S" as BloqES
  state "Esperando red" as BloqRed
}

Ejecucion --> BloqSem : semWait sin recurso
Ejecucion --> BloqES : pide E/S
Ejecucion --> BloqRed : accede a un buffer remoto

Bloqueado --> Listo : semSignal lo despierta,\ntermina la E/S o\npasa la latencia de red

Nuevo --> Terminado : deadline = 0
Listo --> Terminado : deadline = 0
Ejecucion --> Terminado : deadline = 0
Bloqueado --> Terminado : deadline = 0

Terminado --> [*] : libera su RAM

@enduml
